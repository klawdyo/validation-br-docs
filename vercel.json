{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:version(v1|v2)/",
      "destination": "/:version",
      "permanent": true
    },
    {
      "source": "/:slug((?!v1(?:/|$)|v2(?:/|$)|404$|test-icon$|markdown-examples$|api-examples$)[A-Za-z0-9_/-]+)",
      "destination": "/v2/:slug",
      "permanent": true
    }
  ]
}
